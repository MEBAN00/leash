# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Locally: your own Postgres. On Vercel, copy Supabase's transaction
# pooler URI (port 6543) from Project -> Connect. Replace [YOUR-PASSWORD] and
# keep SSL enabled. Prepared statements and excess connections are disabled
# automatically for serverless deployments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leash

# PayPal sandbox REST app: developer.paypal.com -> Apps & Credentials (Sandbox)
# In the app's features, tick "Save payment methods" (Vault API) and "Transaction search".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 product search: trychannel3.com (1,000 free searches/month)
CHANNEL3_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Where the app runs (used for PayPal return/cancel URLs)
APP_URL=http://localhost:3000
