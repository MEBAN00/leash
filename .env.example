# Copy to .env.local and fill in. Never commit .env.local.

# Postgres. Locally: your own Postgres. Production: Supabase.
# On Railway use Supabase's *session pooler* string (IPv4). If you use the
# transaction pooler (port 6543) prepared statements are disabled automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/leash

# PayPal sandbox REST app: developer.paypal.com -> Apps & Credentials (Sandbox)
# In the app's features, tick "Save payment methods" (Vault API) and "Transaction search".
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Channel3 product search: trychannel3.com (1,000 free searches/month)
CHANNEL3_API_KEY=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Where the app runs (used for PayPal return/cancel URLs)
APP_URL=http://localhost:3000
